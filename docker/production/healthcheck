#!/usr/bin/env sh

# Container healthcheck, two signals; the container is unhealthy when either fails.
#
# 1. Supervisor restarts crashed processes; a program it is supposed to run that is not RUNNING
#    (crashed for good, stopped by hand, or never started) or an unreachable supervisord is
#    unhealthy. Programs switched off through RUN_* stay STOPPED and are ignored.
# 2. A FastCGI request for Laravel's `/up` straight to php-fpm (the image has no web server), the
#    request the host NGINX would make. It must answer 200: the framework boots.

output=$(supervisorctl -c /etc/supervisor/supervisord.conf status 2>&1)
status=$?

# supervisorctl exits with 3 when some program is not RUNNING; anything else non-zero means
# supervisord itself is unreachable.
if [ "$status" -ne 0 ] && [ "$status" -ne 3 ]; then
    echo "$output"
    exit 1
fi

is_required() {
    case "$1" in
        php) return 0 ;;
        laravel-scheduler) [ "${RUN_SCHEDULER:-true}" = "true" ] ;;
        laravel-queue-worker:*) [ "${RUN_QUEUE_WORKER:-true}" = "true" ] ;;
        *) return 0 ;;
    esac
}

unhealthy=0

while read -r program state _; do
    [ -n "$program" ] || continue

    if [ "$state" != "RUNNING" ] && is_required "$program"; then
        echo "${program} is ${state}"
        unhealthy=1
    fi
done <<EOF
$output
EOF

# php-fpm only sends a `Status:` header for a status other than 200, so a response with a
# `Content-type:` header and no `Status:` header is a 200.
response=$(
    SCRIPT_NAME=/index.php \
    SCRIPT_FILENAME=/var/www/public/index.php \
    REQUEST_METHOD=GET \
    REQUEST_URI=/up \
    QUERY_STRING= \
    SERVER_PROTOCOL=HTTP/1.1 \
    SERVER_NAME=localhost \
    HTTP_HOST=localhost \
    REMOTE_ADDR=127.0.0.1 \
    GATEWAY_INTERFACE=CGI/1.1 \
    cgi-fcgi -bind -connect 127.0.0.1:9000 2>&1
)
fcgi_status=$?
http_status=$(printf '%s\n' "$response" | sed -n 's/^Status: \([0-9][0-9]*\).*/\1/p' | head -n 1)

if [ "$fcgi_status" -ne 0 ]; then
    echo "FastCGI request for /up failed: ${response}"
    unhealthy=1
elif [ -z "$http_status" ] && printf '%s\n' "$response" | grep -qi '^Content-type:'; then
    :
elif [ "$http_status" != "200" ]; then
    echo "GET /up answered ${http_status:-nothing}"
    unhealthy=1
fi

exit "$unhealthy"
