APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# The dev stack (docker-compose.yml) serves the application on APP_PORT; `artisan serve` on the host is not supported.
APP_PORT=8080
APP_URL=http://localhost:${APP_PORT}

# Addresses or CIDR ranges of the reverse proxies whose forwarded headers (scheme, host, client address) are trusted,
# separated by commas, e.g. 172.18.0.0/16. Empty trusts none, which is right behind the host NGINX: it passes the scheme
# and the client address to php-fpm as FastCGI parameters. Never `*`.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local mail goes to Mailpit (docker-compose.yml): SMTP on MAIL_PORT, inbox UI on http://localhost:${MAILPIT_UI_PORT}.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# OpenTelemetry: every deployed application exports traces and metrics over OTLP/HTTP (protobuf) to the host collector (port 4318).
# Logs go to standard output and error; exporting them over OTLP is optional. gRPC (port 4317) is optional per project and needs the `grpc` PHP extension.
# The `opentelemetry` PHP extension is in the base image; the SDK and the Laravel auto-instrumentation are added by the
# project that turns it on (README, "OpenTelemetry"). Until then OTEL_PHP_AUTOLOAD_ENABLED stays false and nothing is exported.
OTEL_PHP_AUTOLOAD_ENABLED=false
OTEL_SERVICE_NAME=replace-with-app-name
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=none
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local

# Money (App\Domain\ValueObjects\Money): the currency of a row that has none, and of a column cast with `MoneyCast::class . ':config'`.
MONEY_DEFAULT_CURRENCY=CZK
# Production image (docker/production): what the entrypoint starts. Each switch is exactly `true` or `false`.
RUN_MIGRATIONS=true
RUN_SCHEDULER=true
RUN_QUEUE_WORKER=true

# Development docker-compose.yml. WWWUSER/WWWGROUP: `id -u` and `id -g` on Linux, ignored on Docker Desktop / OrbStack.
# The compose services connect to the `mariadb` service (DB_* are overridden there); the plain .env keeps SQLite.
WWWUSER=1000
WWWGROUP=1000
VITE_PORT=5173
FORWARD_DB_PORT=3306
DB_ROOT_PASSWORD=secret
MAILPIT_UI_PORT=8025
# Server-side rendering is off by default; see docs of the project before turning it on.
INERTIA_SSR_ENABLED=false
